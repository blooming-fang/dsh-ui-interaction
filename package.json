{
  "name": "dsh-ui-interaction",
  "version": "0.1.3",
  "description": "UI interaction optimizations for the DeepSeek Harness web GUI: the provider-first two-level model picker (provider → model drill-down) replacing the composer model seat, plus an ambient neon-glow background with a non-white page tint and related surface tweaks; more improvements to come",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "ui",
    "ux",
    "interaction",
    "optimization",
    "enhancement",
    "model",
    "model-picker",
    "model-selection",
    "provider",
    "composer",
    "plugin",
    "bundle",
    "web"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blooming-fang/dsh-ui-interaction.git"
  },
  "bugs": {
    "url": "https://github.com/blooming-fang/dsh-ui-interaction/issues"
  },
  "homepage": "https://github.com/blooming-fang/dsh-ui-interaction#readme",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepare": "pnpm run build",
    "pack:check": "node ./scripts/check-pack.mjs",
    "prepack": "pnpm run build && pnpm run pack:check",
    "pack": "npm pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-commands": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.5",
    "clsx": "^2.1.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-commands": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.5",
    "@types/react": "^18.3.1",
    "clsx": "^2.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
